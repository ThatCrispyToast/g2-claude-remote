# Claude Remote configuration. Copy to `.env.local` and fill in.
#
# VITE_* vars apply to the DEV SERVER ONLY (`npm run dev`) — a convenience so
# your dev panel/glasses connect without retyping settings. `npm run pack`
# ignores this file entirely: a pack resolves no VITE_* vars and never carries
# keys or hosts, so every pack is a distribution pack. On an installed build,
# the panel's Settings card (stored only on the device) is the config path.

# ─── The bridge (required) ───────────────────────────────────────────────────
# Base URL of the bridge (`npm run bridge`), as reachable FROM THE PHONE.
# Use a name that works from anywhere you wear the glasses — the host's
# Tailscale MagicDNS name (recommended, e.g. http://my-box.tailXXXX.ts.net:8790)
# or a LAN IP.
VITE_BRIDGE_URL=http://localhost:8790
# Shared secret guarding the bridge. The bridge reads this same file, so
# setting it once here configures both sides (an RC_BRIDGE_TOKEN env var wins).
# Left blank, the bridge generates a word passphrase on first run, prints it,
# and saves it to ~/.config/claude-remote/bridge-token — paste that here.
VITE_BRIDGE_TOKEN=

# ─── Polling / display (optional) ────────────────────────────────────────────
VITE_POLL_MS=4000            # active-session list refresh interval
VITE_HISTORY_LIMIT=200       # events pulled when a session is opened
# The session view scrolls natively on the glasses (no software paging). Two
# body windows: the auto-following live tail, and the frozen history window the
# firmware scrolls smoothly when you swipe up. The live tail must never overflow
# (the firmware won't scroll it to the newest line), so it is budgeted in
# estimated wrapped ROWS, with a byte ceiling on top. Byte caps are UTF-8 bytes:
# the firmware measures text containers that way, and HUD glyphs are multi-byte.
VITE_LIVE_ROWS=6             # live-tail height in rendered rows
VITE_HUD_CHARS_PER_ROW=40    # average chars per wrapped row (for the row estimate)
VITE_LIVE_BODY_BYTES=320     # live-tail byte ceiling
VITE_HISTORY_BYTES=900       # history window in bytes (a few screens; < the ~1000B cap)
VITE_TOOL_ARG_CHARS=18       # arg half of a tool-chain entry ("Read factory.py")

# One-tap canned messages for the Compose menu (JSON array of {label,text}).
# Default: Proceed / Run tests / Explain. Override with your own set:
# VITE_QUICK_SENDS=[{"label":"Continue","text":"continue"},{"label":"Yes","text":"yes"}]

# Canned side questions for the Compose → Ask aside submenu (JSON array of
# strings). A side question is answered from the conversation without
# interrupting the session or entering its transcript (one model call).
# VITE_ASIDE_QUESTIONS=["What are you doing right now?","Any tests failing?"]

# Slash commands for the Compose → Commands submenu (glasses) and the panel's `/`
# autocomplete. Sent as a plain `/name` message — the worker runs it locally at
# zero cost. Default: context / usage / mcp / compact / clear (validated to run
# over remote-control). Keep to "fire-and-observe" commands — interactive ones
# (/login, /config, /vim) and RC-refused ones (/status, /release-notes) don't
# work remotely. `confirm:true` gates heavy/destructive ones; `takesArg:true`
# makes the panel wait for a typed argument. Override with a JSON array of
# {name,label,hint?,takesArg?,confirm?}:
# VITE_SLASH_COMMANDS=[{"name":"context","label":"Context usage"},{"name":"pr","label":"Open a PR","takesArg":true}]

# ─── Voice dictation (optional; needs a Deepgram key) ────────────────────────
# Leave the key blank to disable voice input entirely (quick-actions still work).
# Free-tier keys from https://console.deepgram.com work fine.
VITE_DEEPGRAM_API_KEY=
VITE_DEEPGRAM_MODEL=nova-3
# Deepgram language code: en, de, fr, … or `multi` for mixed-language speech.
# Also settable per device in the panel's Settings card ("Dictation language").
VITE_STT_LANGUAGE=en
VITE_VOICE_ENABLED=true
VITE_MIC_SILENCE_TIMEOUT_MS=8000
