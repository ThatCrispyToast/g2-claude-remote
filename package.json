{
  "name": "claude-remote",
  "private": true,
  "version": "1.11.1",
  "repository": "github:ThatCrispyToast/g2-claude-remote",
  "description": "Monitor and steer Claude Code Remote Control sessions from Even Realities G2 glasses",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bridge": "python3 server/rc_bridge.py",
    "bridge:uv": "uv run --project ../claude-rc-api python server/rc_bridge.py",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && node scripts/check-versions.mjs && evenhub pack app.json dist --sdk-ver 0.0.16 -o claude-remote-$npm_package_version.ehpk",
    "simulate": "evenhub-simulator http://localhost:5175"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
